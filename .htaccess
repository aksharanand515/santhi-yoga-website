# ------------------------------------------------------------------
# Santhi Yoga India — server settings for Hostinger (Apache / LiteSpeed)
# Upload this file to public_html together with the website files.
# (GitHub Pages ignores it.)
# ------------------------------------------------------------------

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for the whole site: https://santhiyogaindia.com (matches the canonical tags)
  RewriteCond %{HTTP_HOST} ^www\.santhiyogaindia\.com$ [NC]
  RewriteRule ^(.*)$ https://santhiyogaindia.com/$1 [R=301,L]

  # Build templates, tools and internal content planning are not part of the public site
  RewriteRule ^(partials|tools|content)(/|$) - [F,L]

  # ----------------------------------------------------------------
  # Addresses from the old WordPress site, kept alive so that links
  # and search results still land somewhere useful. 301 = moved for
  # good, which is what passes the old page's standing to the new one.
  # ----------------------------------------------------------------
  RewriteRule ^teacher-training-services/?$      /teacher-training/ [R=301,L]
  RewriteRule ^yoga-teacher-training-kerala/?$   /teacher-training/ [R=301,L]
  RewriteRule ^200-hour-yoga-teacher-training/?$ /teacher-training/ [R=301,L]
  RewriteRule ^ttc/?$                            /teacher-training/ [R=301,L]
  RewriteRule ^(yoga-)?classes(-kochi)?/?$       /services/ [R=301,L]
  RewriteRule ^daily-yoga-classes/?$             /services/ [R=301,L]
  RewriteRule ^online-classes/?$                 /services/ [R=301,L]
  RewriteRule ^hatha-yoga/?$                     /services/ [R=301,L]
  RewriteRule ^workshops/?$                      /services/ [R=301,L]
  RewriteRule ^(yoga-)?retreats/?$               /services/ [R=301,L]
  RewriteRule ^about-us/?$                       /about/ [R=301,L]
  RewriteRule ^contact-us/?$                     /contact/ [R=301,L]

  # WordPress leftovers: these will never exist again, so tell crawlers
  # to drop them rather than keep retrying a soft 404.
  RewriteRule ^(wp-content|wp-includes|wp-admin|wp-json)(/|$) - [G,L]
  RewriteRule ^(cart|checkout|my-account|shop)/?$             - [G,L]

</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript image/svg+xml
</IfModule>

# Caching: pages are always re-checked; CSS and JS carry a version number (?v=…)
# that changes on every build, and photos and fonts never change under the same name.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|jpe?g|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# A branded page for anything not found, instead of the host's default error page.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
